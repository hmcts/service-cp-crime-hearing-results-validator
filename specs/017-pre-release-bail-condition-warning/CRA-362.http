### CRA-362 / DR-BAIL-016 — Pre-release bail condition warning scratch file
### hearingDay fixed at 2026-11-09 for reproducible age calculations

@baseUrl = http://localhost:4550
@validatePath = /api/validation/validate

###
# AC1 — Adult (18+), result RC, trigger condition PASS5, bailStatus C → Warning A
POST {{baseUrl}}{{validatePath}}
Content-Type: application/json
CJSCPPUID: test-user
CPP-ACTION: validation-service.validate

{
  "hearingId": "h-cra362-ac1",
  "hearingDay": "2026-11-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {"resultLineId": "rl1", "shortCode": "RC",    "label": "RC",    "defendantId": "d1", "offenceId": "off-1"},
    {"resultLineId": "rl2", "shortCode": "PASS5", "label": "Passport surrendered", "defendantId": "d1", "offenceId": "off-1"}
  ],
  "defendants": [{"defendantId": "d1", "firstName": "Jane", "lastName": "Doe", "dateOfBirth": "1990-01-01"}],
  "offences": [{"offenceId": "off-1", "defendantId": "d1", "offenceCode": "TH68001", "offenceTitle": "Theft", "orderIndex": 1, "bailStatus": "C"}]
}

