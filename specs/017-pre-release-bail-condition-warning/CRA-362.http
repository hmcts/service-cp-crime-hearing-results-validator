# AC4A — DR-BAIL-016 coexists alongside DR-RESTRAO-010 (neither suppresses the other)
POST {{baseUrl}}{{validatePath}}
Content-Type: application/json
CJSCPPUID: test-user
CPP-ACTION: validation-service.validate

{
  "hearingId": "h-cra362-ac4a",
  "hearingDay": "2026-11-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {"resultLineId": "rl1", "shortCode": "RC",      "label": "RC",      "defendantId": "d1", "offenceId": "off-bail"},
    {"resultLineId": "rl2", "shortCode": "PASS5",   "label": "PASS5",   "defendantId": "d1", "offenceId": "off-bail"},
    {"resultLineId": "rl3", "shortCode": "RESTRAO", "label": "RESTRAO", "defendantId": "d1", "offenceId": "off-rao",
     "prompts": [{"promptRef": "protectedPersonsName", "promptValue": "John Smith & Jane Smith"}]}
  ],
  "defendants": [{"defendantId": "d1", "firstName": "Jane", "lastName": "Doe", "dateOfBirth": "1990-01-01"}],
  "offences": [
    {"offenceId": "off-bail", "defendantId": "d1", "offenceCode": "TH68001", "offenceTitle": "Theft A", "orderIndex": 1, "bailStatus": "C"},
    {"offenceId": "off-rao",  "defendantId": "d1", "offenceCode": "TH68002", "offenceTitle": "RAO offence", "orderIndex": 2, "bailStatus": "B"}
  ]
}
