@baseUrl = http://localhost:4550
@validateUrl = {{baseUrl}}/api/validation/validate
@userId = test-user
@hearingDay = 2026-06-15

# DR-BAIL-015 — Pre-release bail conditions on a conditional bail result (CRA-363)
#
# Blocks sharing (ERROR) when a conditional bail parent result coexists with a
# pre-release bail condition child result on the same offence.
#
# Parent result short codes — remand on conditional bail:
#   RC, RCBV, BAILREVC, REMCB, REMCBY, RCCCB
# Parent result short codes — custody with bail direction:
#   CCIC, CCSC
# Pre-release bail condition short codes (child):
#   PREBC, PRBCO, PRBCP1–PRBCP8, PRBCS1–PRBCS3, PRBCSE1, PRBCSE2, PRBCT
#
# Age on hearing day ({{hearingDay}}):
#   Adult (18+): DOB 1990-01-01  (age 36)
#   Youth (<18): DOB 2012-01-01  (age 14)

# ─────────────────────────────────────────────────────────────────────────────
# AC1 — Adult defendant with remand bail parent → Error A (blocking)
# Expected: isValid=false, 1 ERROR, ruleId=DR-BAIL-015,
#   message contains "use 'Remanded in custody with bail direction (RIB)'"
# ─────────────────────────────────────────────────────────────────────────────

### AC1 — Adult + RC parent + PREBC child → Error A
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}
CPP-ACTION: validation-service.validate

{
  "hearingId": "bail-ac1-adult-rc",
  "hearingDay": "{{hearingDay}}",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {"resultLineId": "rl1", "shortCode": "RC",    "label": "RC",    "defendantId": "d1", "offenceId": "off1"},
    {"resultLineId": "rl2", "shortCode": "PREBC", "label": "PREBC", "defendantId": "d1", "offenceId": "off1"}
  ],
  "defendants": [
    {"defendantId": "d1", "masterDefendantId": "d1", "firstName": "John", "lastName": "Smith", "dateOfBirth": "1990-01-01"}
  ],
  "offences": [
    {"offenceId": "off1", "defendantId": "d1", "offenceCode": "TH68001", "offenceTitle": "Theft", "orderIndex": 1, "caseUrn": "AC001"}
  ]
}

###

