# ─────────────────────────────────────────────────────────────────────────────
# AC5A — Error co-exists with another validation rule error (DR-SENT-001)
# DR-BAIL-015 (d1: RC+PREBC → Error A) fires alongside DR-SENT-001
# (d2: two IMP results where one has isConcurrent=true AND consecutiveToOffence set).
# Expected: isValid=false, DR-BAIL-015 ERROR in errors.validationIssues,
#   DR-SENT-001 WARNING in warnings; neither suppresses the other.
# ─────────────────────────────────────────────────────────────────────────────

### AC5A — DR-BAIL-015 alongside DR-SENT-001 → both fire, neither suppressed
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}
CPP-ACTION: validation-service.validate

{
  "hearingId": "bail-ac5a-alongside-sent001",
  "hearingDay": "{{hearingDay}}",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {"resultLineId": "rl1", "shortCode": "RC",    "label": "RC",    "defendantId": "d1", "offenceId": "off1"},
    {"resultLineId": "rl2", "shortCode": "PREBC", "label": "PREBC", "defendantId": "d1", "offenceId": "off1"},
    {"resultLineId": "rl3", "shortCode": "IMP",   "label": "IMP",   "defendantId": "d2", "offenceId": "off2"},
    {"resultLineId": "rl4", "shortCode": "IMP",   "label": "IMP",   "defendantId": "d2", "offenceId": "off3",
     "isConcurrent": true, "consecutiveToOffence": "off2"}
  ],
  "defendants": [
    {"defendantId": "d1", "masterDefendantId": "d1", "firstName": "John",  "lastName": "Smith", "dateOfBirth": "1990-01-01"},
    {"defendantId": "d2", "masterDefendantId": "d2", "firstName": "Alex",  "lastName": "Green"}
  ],
  "offences": [
    {"offenceId": "off1", "defendantId": "d1", "offenceCode": "TH68001", "offenceTitle": "Theft",   "orderIndex": 1, "caseUrn": "AC5A01"},
    {"offenceId": "off2", "defendantId": "d2", "offenceCode": "AS001",   "offenceTitle": "Assault", "orderIndex": 2, "caseUrn": "AC5A01"},
    {"offenceId": "off3", "defendantId": "d2", "offenceCode": "RS001",   "offenceTitle": "Other",   "orderIndex": 3, "caseUrn": "AC5A01"}
  ]
}

