  "hearingId": "bail-ac8-rib-not-parent",
  "hearingDay": "{{hearingDay}}",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {"resultLineId": "rl1", "shortCode": "RIB",   "label": "RIB",   "defendantId": "d1", "offenceId": "off1"},
    {"resultLineId": "rl2", "shortCode": "PREBC", "label": "PREBC", "defendantId": "d1", "offenceId": "off1"}
  ],
  "defendants": [
