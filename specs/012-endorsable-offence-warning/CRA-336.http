# ─────────────────────────────────────────────────────────────────────────────
# US5 — Coexistence: DR-ENDORSEMENT-012 alongside another validation warning
# ─────────────────────────────────────────────────────────────────────────────

### US5-AC7 — DR-ENDORSEMENT-012 + DR-SENT-001 coexistence
# off-1: d1, endorsable (flag=1), IMP/F, no satisfying → DR-ENDORSEMENT-012 WARNING
# off-2+off-3: d2, both marked concurrent (no primary sentence) → DR-SENT-001 WARNING
# Expected: 2 warnings, one per rule, neither suppresses the other, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-end012-us5-ac7-coexist",
  "hearingDay": "2026-10-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d2",
      "offenceId": "off-2",
      "isConcurrent": true
    },
    {
      "resultLineId": "rl3",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d2",
      "offenceId": "off-3",
      "isConcurrent": true
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Jane", "lastName": "Driver" },
    { "defendantId": "d2", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-endorsable-flag1",
      "offenceTitle": "Speeding",
      "orderIndex": 1
    },
    {
      "offenceId": "off-2",
      "defendantId": "d2",
      "offenceCode": "live-endorsable-flag0",
      "offenceTitle": "Theft A",
      "orderIndex": 2
    },
    {
      "offenceId": "off-3",
      "defendantId": "d2",
      "offenceCode": "live-endorsable-flag0",
      "offenceTitle": "Theft B",
      "orderIndex": 3
    }
  ]
}

