# ─────────────────────────────────────────────────────────────────────────────
# Edge cases
# ─────────────────────────────────────────────────────────────────────────────

### Edge — Satisfying code on a non-final line still suppresses the warning
# Satisfying codes are checked across ALL result lines (not just Category F).
# rl1: IMP/F (qualifying final), rl2: LEP/A (non-final) → warning suppressed.
# Expected: 0 DR-ENDORSEMENT-012 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-end012-edge-satisfying-nonfinal",
  "hearingDay": "2026-10-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "LEP",
      "category": "A",
      "label": "Licence Endorsement — Points",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Jane", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-endorsable-flag1",
      "offenceTitle": "Speeding",
      "orderIndex": 1
    }
  ]
}

###

### Edge — Excluded final result alongside a non-excluded final result → WARNING still fires
# If at least one non-excluded Category-F line is present, the excluded one doesn't matter.
# rl1: WDRN/F (excluded), rl2: IMP/F (non-excluded) → warning fires.
# Expected: 1 DR-ENDORSEMENT-012 WARNING for off-1, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-end012-edge-excluded-plus-nonexcluded",
  "hearingDay": "2026-10-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "WDRN",
      "category": "F",
      "label": "Withdrawn",
      "defendantId": "d1",
      "offenceId": "off-1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Jane", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-endorsable-flag1",
      "offenceTitle": "Speeding",
      "orderIndex": 1
    }
  ]
}

###

### Edge — No Category-F result (only interim) → NO warning, no ref-data call made
# The preprocessor short-circuits when no qualifying final line exists;
# the endorsable_flag lookup is skipped entirely.
# Expected: 0 DR-ENDORSEMENT-012 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-end012-edge-no-final",
  "hearingDay": "2026-10-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "ADJ",
      "category": "A",
      "label": "Adjourned",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Jane", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-endorsable-flag1",
      "offenceTitle": "Speeding",
      "orderIndex": 1
    }
  ]
}

