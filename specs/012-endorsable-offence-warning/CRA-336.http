@baseUrl = http://localhost:4550
@validateUrl = {{baseUrl}}/api/validation/validate
@userId = test-user

# DR-ENDORSEMENT-012 — Endorsement/Disqualification Missing on Endorsable Offences (CRA-336)
# Warns when a Category F – Final result is recorded against an endorsable offence
# (endorsable_flag = 1 from reference data) and no satisfying endorsement, disqualification,
# or special reasons result is present.
#
# Satisfying codes that suppress the warning:
#   Endorsement (3):                LEP  LEN  LEA
#   Obligatory disqualification (5): DDO  DDOL  DDOR  DDOTE  DDOTEL
#   Discretionary disqualification (5): DDD  DDDL  DDDT  DDDTL  DDDTO
#   Points/totting disqualification (5): DDP  DDPL  DDPR  DDPTE  DDPTEL
#   Course reduction (1):           DDRCOT
#   Special reasons (2):            NESR  NDSR
#
# Excluded final codes (warning suppressed even if flag=1, 24 codes):
#   WDRN WDRNOFF DISM DINE DINI DISCH DISC CTROF IREMFILE ERR ERRF DHD ONI
#   DCS DCCFSA DCCFSTA CQUASH IQUASH RESTRAO STAYP RBBH SOCOR PDW RBBO
#
# Severity: WARNING (advisory — sharing is not blocked).
#
# PREREQUISITE: start the stack first:
#   gradle bootJar && docker compose up --build --force-recreate -d
#
# WireMock stubs for the offence codes below live in:
#   wiremock/mappings/referencedataoffences-endorsable-stub.json
#
#   live-endorsable-flag1  → endorsableFlag: 1  (endorsable offence)
#   live-endorsable-flag0  → endorsableFlag: 0  (non-endorsable offence)
#   live-endorsable-absent → endorsableFlag absent in response (fail-open: treated as non-endorsable)
#
# Note: IMP is a custodial short code (DR-SENT-011 territory) but the stubs above return no
# custodialIndicator, so DR-SENT-011 stays silent (fail-open → treated as imprisonable).

# ─────────────────────────────────────────────────────────────────────────────
# US1 — Advisory warning: endorsable offence with non-excluded final result,
#        no satisfying result → WARNING
# ─────────────────────────────────────────────────────────────────────────────

### US1-AC1 — endorsable_flag=1, Category-F result (IMP), no satisfying code → WARNING
# Expected: 1 WARNING with ruleId=DR-ENDORSEMENT-012, severity=WARNING, isValid=true,
#           affectedOffences contains off-1,
#           message = "This offence is endorsable. Add an endorsement, disqualification or special reasons result."
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-end012-us1-ac1",
  "hearingDay": "2026-10-09",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "category": "F",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Jane", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-endorsable-flag1",
      "offenceTitle": "Speeding",
      "orderIndex": 1
    }
  ]
}

