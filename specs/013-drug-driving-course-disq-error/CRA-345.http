# US4 — Amend and reshare: same error reappears when DDRCO added post-sharing
# ─────────────────────────────────────────────────────────────────────────────

### US4/AC1 — Amendment path: DDRCO added to triggering offence after prior share → same ERROR
# The service is stateless with respect to amendment vs initial entry — the validate
# endpoint behaves identically in both cases.
# Expected: isValid=false, one ERROR with prescribed message.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-us4-amend-reshare",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    }
  ]
}

