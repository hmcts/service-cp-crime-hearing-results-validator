### MD1 — d1 triggers error (DDRCO on RT88584), d2 does not (DDO on RT88584) → ERROR for d1 only
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-md1-two-defendants",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "DDO",
      "category": "F",
      "label": "Driving Disqualification (obligatory)",
      "defendantId": "d2",
      "offenceId": "off2"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" },
    { "defendantId": "d2", "firstName": "Sam", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    },
    {
      "offenceId": "off2",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 2,
      "isConvicted": true,
      "defendantId": "d2"
    }
  ]
}

