### AC3 — Two drug driving offences each with DDRCO → 2 separate ERRORs
# off1 (RT88584) + off2 (RT88586), each with DDRCO → 2 errors, each scoped to its own offence.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-ac3-two-offences",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off2"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    },
    {
      "offenceId": "off2",
      "offenceCode": "RT88586",
      "offenceTitle": "Attempt to drive with specified controlled drug above limit",
      "orderIndex": 2,
      "isConvicted": true,
      "defendantId": "d1"
    }
  ]
}

###

# ─────────────────────────────────────────────────────────────────────────────
# US2 — Error is cleared when unlawful result is replaced with a lawful one
# ─────────────────────────────────────────────────────────────────────────────

### US2 — Drug driving offence with DDO (lawful disqualification) after replacing DDRCO → no error
# Represents the corrected state after the user follows the error guidance.
# Expected: isValid=true, no DR-DISQ-013 issue.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-us2-replaced-with-ddo",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDO",
      "category": "F",
      "label": "Driving Disqualification (obligatory)",
      "defendantId": "d1",
      "offenceId": "off1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    }
  ]
}

