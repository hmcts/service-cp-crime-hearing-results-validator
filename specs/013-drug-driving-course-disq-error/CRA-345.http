# Edge Cases
# ─────────────────────────────────────────────────────────────────────────────

### EC1 — DDRCO alongside another result on the same offence → ERROR still fires
# Spec edge case: rule fires regardless of other results present on the same offence.
# Expected: isValid=false, one ERROR.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-ec1-mixed-results",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "DDO",
      "category": "F",
      "label": "Driving Disqualification (obligatory)",
      "defendantId": "d1",
      "offenceId": "off1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    }
  ]
}

