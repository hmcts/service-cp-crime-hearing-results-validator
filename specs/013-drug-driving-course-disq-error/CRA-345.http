@baseUrl = http://localhost:4550
@validateUrl = {{baseUrl}}/api/validation/validate
@userId = test-user

# DR-DISQ-013 — Drug Driving Course-Reduction Disqualification Error (CRA-345)
# Blocks sharing when DDRCO or DDRCOT is recorded against a drug driving offence.
#
# Triggering offence codes:
#   RT88584  — Drive with specified controlled drug above limit (s.5A)
#   RT88586  — Attempt to drive with specified controlled drug above limit
#   RT88584B — Aid/abet driving with specified controlled drug above limit
#   RT88340  — Drive whilst unfit through drugs (s.4)
#   RA88045  — Cause death by careless driving while over specified controlled drug limit
#
# Course-reduction short codes: DDRCO | DDRCOT

# ─────────────────────────────────────────────────────────────────────────────
# US1 — Error fires when DDRCO / DDRCOT applied to a drug driving offence
# ─────────────────────────────────────────────────────────────────────────────

### AC1a — DDRCO on RT88584 → ERROR
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-ac1a-ddrco",
  "hearingDay": "2026-10-16",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "DDRCO",
      "category": "F",
      "label": "Driving Disq (obligatory) — Reduction for course",
      "defendantId": "d1",
      "offenceId": "off1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Driver" }
  ],
  "offences": [
    {
      "offenceId": "off1",
      "offenceCode": "RT88584",
      "offenceTitle": "Drug driving s.5A — specified controlled drug",
      "orderIndex": 1,
      "isConvicted": true,
      "defendantId": "d1"
    }
  ]
}

