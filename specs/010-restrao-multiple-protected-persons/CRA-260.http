# ─────────────────────────────────────────────────────────────────────────────
# US3 — Multiple RESTRAO offences evaluated independently
# Each offence is evaluated in isolation — warnings are scoped per offence.
# ─────────────────────────────────────────────────────────────────────────────

### US3-A — Two RESTRAO offences, one breaching (off-1), one clean (off-2) → WARNING on off-1 only
# Expected: 1 WARNING scoped to off-1.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-restrao-us3-two-offences",
  "hearingDay": "2026-05-06",
  "courtType": "CROWN",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "RESTRAO",
      "label": "Restraining Order",
      "defendantId": "d1",
      "offenceId": "off-1",
      "prompts": [
        { "promptRef": "protectedPersonsName", "promptValue": "John Smith & Jane Smith" }
      ]
    },
    {
      "resultLineId": "rl2",
      "shortCode": "RESTRAO",
      "label": "Restraining Order",
      "defendantId": "d1",
      "offenceId": "off-2",
      "prompts": [
        { "promptRef": "protectedPersonsName", "promptValue": "Jane Smith" }
      ]
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Jones" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "offenceCode": "TH68001",
      "offenceTitle": "Harassment (count 1)",
