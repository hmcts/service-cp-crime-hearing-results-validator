@baseUrl = http://localhost:4550
@validateUrl = {{baseUrl}}/api/validation/validate
@userId = test-user

# DR-RESTRAO-010 — Restraining Order: Multiple Protected Persons Warning (CRA-260)
# Warns when a RESTRAO result's protectedPersonsName prompt contains multiple names,
# detected by: & | , | / separators, or whole-word "and" (case-insensitive).
#
# Rule fires per offence — each offence with a RESTRAO result is evaluated independently.
# Severity: WARNING (advisory — sharing is not blocked).

# ─────────────────────────────────────────────────────────────────────────────
# US1 — Separator character detection (AC1)
# Expected: 1 WARNING with ruleId=DR-RESTRAO-010, severity=WARNING, isValid=true
# ─────────────────────────────────────────────────────────────────────────────

### US1-A — Ampersand (&) in protectedPersonsName → WARNING
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-restrao-us1-ampersand",
  "hearingDay": "2026-05-06",
  "courtType": "CROWN",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "RESTRAO",
      "label": "Restraining Order",
      "defendantId": "d1",
      "offenceId": "off-1",
      "prompts": [
        { "promptRef": "protectedPersonsName", "promptValue": "John Smith & Jane Smith" }
      ]
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "Alex", "lastName": "Jones" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "offenceCode": "TH68001",
      "offenceTitle": "Harassment",
      "orderIndex": 1,
      "defendantId": "d1"
    }
  ]
}

