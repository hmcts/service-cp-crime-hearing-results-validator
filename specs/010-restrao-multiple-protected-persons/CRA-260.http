      "defendantId": "d1"
    },
    {
      "offenceId": "off-2",
      "offenceCode": "TH68001",
      "offenceTitle": "Harassment (count 2)",
      "orderIndex": 2,
      "defendantId": "d1"
    }
  ]
}

