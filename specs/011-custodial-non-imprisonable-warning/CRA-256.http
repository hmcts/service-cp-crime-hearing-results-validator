# ─────────────────────────────────────────────────────────────────────────────
# US4 — Non-custodial result lines do not trigger the rule; ref-data not called
# ─────────────────────────────────────────────────────────────────────────────

### US4-AC7-A — COEW result + offence classified N in ref-data → NO warning
# COEW is not a custodial short code — preprocessor produces no context entry,
# reference-data lookup is never made.
# Expected: 0 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us4-coew",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "COEW",
      "label": "Convicted — England and Wales",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

