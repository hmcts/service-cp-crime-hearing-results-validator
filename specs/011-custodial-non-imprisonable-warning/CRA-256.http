### US5-B — Mixed offences: imprisonable (off-1, ref-data Y) + non-imprisonable (off-2, ref-data N)
# Warning scoped to off-2 only; off-1 is clean.
# Expected: 1 WARNING for off-2, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us5-mixed",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-2"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-y",
      "offenceTitle": "Theft (imprisonable)",
      "orderIndex": 1
    },
    {
      "offenceId": "off-2",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-n",
      "offenceTitle": "Theft (non-imprisonable)",
      "orderIndex": 2
    }
  ]
}

