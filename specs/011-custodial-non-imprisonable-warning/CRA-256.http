# ─────────────────────────────────────────────────────────────────────────────
# US2 — details_json fallback: when column is absent, details.document.libra.custodialindicator.code
#        is consulted. Column always wins when present.
# WireMock: live-nonimprisonable-json-n → {custodialIndicator: null, details: {…code: "N"}}
#           live-nonimprisonable-json-y → {custodialIndicator: null, details: {…code: "Y"}}
#           live-nonimprisonable-no-ind → no custodialIndicator, no details
# ─────────────────────────────────────────────────────────────────────────────

### US2-AC3 — column absent, details_json code="N" → WARNING
# Expected: 1 WARNING with ruleId=DR-SENT-011, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us2-json-n",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-json-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

