    {
      "resultLineId": "rl1",
      "shortCode": "SUSPS",
      "label": "Suspended Sentence",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

###

### Edge case — Two custodial result lines on the same non-imprisonable offence → exactly 1 WARNING
# The preprocessor evaluates per-offence, not per-result-line, so a second custodial result on
# the same offence must not duplicate the warning.
# Expected: exactly 1 WARNING (not 2), ruleId=DR-SENT-011, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-edge-two-results-one-offence",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    },
    {
      "resultLineId": "rl2",
      "shortCode": "SUSPS",
      "label": "Suspended Sentence",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

