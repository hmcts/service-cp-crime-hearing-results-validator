### US2-AC6 — no indicator in either source → NO warning (fail-safe/fail-open)
# Ref-data returns an offence with no custodialIndicator and no details_json node.
# Offence treated as imprisonable — no false-positive warning.
# Expected: 0 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us2-no-ind",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-no-ind",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

