# ─────────────────────────────────────────────────────────────────────────────
# US3 — Column takes precedence over details_json
# WireMock: live-nonimprisonable-col-y-json-n → {custodialIndicator: "Y", details: {…code: "N"}}
# ─────────────────────────────────────────────────────────────────────────────

### US3-AC5 — column="Y" beats details_json code="N" → NO warning
# Column "Y" is consulted first and is usable — JSON fallback is never reached.
# Expected: 0 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us3-column-wins",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-col-y-json-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

