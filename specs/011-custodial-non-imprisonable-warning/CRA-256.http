@baseUrl = http://localhost:4550
@validateUrl = {{baseUrl}}/api/validation/validate
@userId = test-user

# DR-SENT-011 — Custodial Sentence Against Non-Imprisonable Offence Warning (CRA-256)
# Warns when a custodial result line is recorded against an offence whose custodial indicator
# resolves to "N" (non-imprisonable). The indicator is resolved from the reference-data API
# (GET /referencedataoffences/offences?cjsoffencecode=...) in priority order:
#   1. custodialIndicator column ("Y"/"N") — takes precedence if present
#   2. details.document.libra.custodialindicator.code from details_json
# When neither source provides a usable value, the offence is treated as imprisonable (fail-safe).
# Custodial short codes: IMP YOI DTO EXTDVS EXTDVSU EXTIVS STSDY SPECC SPECCC SPECCD
#                        SUSPS SUSPSS SUSPSNI SUSPSNR SUSPSD SUSPSDS SUSPSDNI SUSPSDNR
# Severity: WARNING (advisory — sharing is not blocked).
#
# PREREQUISITE: start the stack first:
#   gradle bootJar && docker compose up --build --force-recreate -d
#
# WireMock stubs for all offence codes below live in:
#   wiremock/mappings/referencedataoffences-nonimprisonable-stub.json

# ─────────────────────────────────────────────────────────────────────────────
# US1 — Custodial indicator column: column-N triggers warning, column-Y suppresses it
# WireMock: live-nonimprisonable-n → {"custodialIndicator": "N"}
#           live-nonimprisonable-y → {"custodialIndicator": "Y"}
# ─────────────────────────────────────────────────────────────────────────────

### US1-AC2 — custodialIndicator="N" (from ref-data) + IMP result → WARNING
# Expected: 1 WARNING with ruleId=DR-SENT-011, severity=WARNING, isValid=true,
#           affectedOffences contains off-1.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us1-column-n",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-n",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

###

### US1-AC1 — custodialIndicator="Y" (from ref-data) + IMP result → NO warning
# Expected: 0 DR-SENT-011 warnings, isValid=true.
POST {{validateUrl}}
Content-Type: application/json
CJSCPPUID: {{userId}}

{
  "hearingId": "h-sent011-us1-column-y",
  "hearingDay": "2026-03-11",
  "courtType": "MAGISTRATES",
  "resultLines": [
    {
      "resultLineId": "rl1",
      "shortCode": "IMP",
      "label": "Imprisonment",
      "defendantId": "d1",
      "offenceId": "off-1"
    }
  ],
  "defendants": [
    { "defendantId": "d1", "firstName": "John", "lastName": "Smith" }
  ],
  "offences": [
    {
      "offenceId": "off-1",
      "defendantId": "d1",
      "offenceCode": "live-nonimprisonable-y",
      "offenceTitle": "Theft",
      "orderIndex": 1
    }
  ]
}

